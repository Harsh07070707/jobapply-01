# --- Python ---
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
dist/
build/

# --- App outputs / state ---
output/
.jobapply/
*.sqlite

# --- Secrets / local config ---
.env
jobapply.toml

# --- Alembic / migrations ---
# Never commit a generated migration that references local paths or secrets.
# The versions/ directory itself IS committed; only generated SQL dumps are not.
alembic_output/

# --- Profile + run artifacts (personal data — never commit) ---
profile.md
profile.json
inspiration.md
*Profile_Updated*
*LinkedInProfile*
resume-test.*
cover_letter-test.*
*-test.pdf
*-test.tex

# --- Web frontend ---
web/node_modules/
web/.vite/
web/dist/
# Vite outputs the prod bundle here; commit only when you've cut a release
# (`cd web && npm run build`). Local dev should rely on `npm run dev`.
jobapply/web_dist/

# --- OS / editor ---
.DS_Store
.idea/
.vscode/
