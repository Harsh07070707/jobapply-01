# JobApply Environment Configuration
# Copy this file to .env and fill in your values

# --- Platform Auth (auto-generated) ---
SECRET_KEY=REPLACE_WITH_RANDOM_SECRET

# --- Database ---
DATABASE_URL=sqlite:///./jobapply_dev.db

# --- Email (Optional) ---
# Get free key at: https://resend.com/signup
# Without this, verification links print to terminal
RESEND_API_KEY=

# --- Email From Address ---
# Default sender for verification emails
# If using Resend, must be a verified domain or use onboarding@resend.dev
EMAIL_FROM=onboarding@resend.dev

# --- App Base URL ---
# Used for generating verification links
APP_BASE_URL=http://localhost:8000
